.container
  %ul.error-messages
    - @shrine.errors.full_messages.each do |message|
      %li= message
  = form_with(model: @shrine, url: shrines_path(return_to: params[:return_to]), local: true) do |f|
    .field
      %div
        = f.label :name, '【神社名】'
      %div
        = f.text_field :name, class: 'text'

    .field
      %div
        = f.label :prefecture, '【都道府県】'
      %div
        = f.select :prefecture,
          Shrine::PREFECTURES,
          { include_blank: '選択してください' },
          class: 'select'

    .field
      %div
        = f.label :address, '【住所】'
      %div
        = f.text_field :address, class: 'text'

    .field
      %div
        = f.label :deities, '【御祭神】'
      %div
        = f.text_area :deities, class: 'text'

    .field
      %div
        = f.label :blessings, '【御利益】'
      %div
        = f.text_area :blessings, class: 'text'

    .field
      = f.submit '保存', class: 'button-primary'

  = link_to (params[:return_to].presence || shrines_path) do
    .back
      .back_icon
        %i.fa-solid.fa-rotate-left
      .back_text
        %p 戻る
