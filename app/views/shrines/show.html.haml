.container
  .card
    .card_header
      .title-row
        %h2.card_name= @shrine.name
        .card_actions
          = link_to '編集', edit_shrine_path(@shrine)
          = link_to '削除', shrine_path(@shrine), data: { turbo_method: 'delete', turbo_confirm: '削除します。よろしいですか？'}
      .divider
    .card_info
      .card_info_item
        .card_info_item_label
          住所
        .card_info_item_content
          = @shrine.address
      .card_info_item
        .card_info_item_label
          御祭神
        .card_info_item_content
          = @shrine.deities
      .card_info_item
        .card_info_item_label
          御利益
        .card_info_item_content
          = @shrine.blessings

  = link_to shrines_path do
    .back
      .back_icon
        %i.fa-solid.fa-rotate-left
      .back_text
        %p 神社一覧へ戻る
