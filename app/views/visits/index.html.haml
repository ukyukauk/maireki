.container
  .visits
    - @visits.each do |visit|
      = link_to visit_path(visit), class: 'card' do
        .visit_container
          .visit_date
            = I18n.l(visit.visited_on, format: :default)
          .visit_shrine-name
            = visit.shrine.name

  = link_to new_visit_path do
    .add-button
      %i.fa.fa-plus
