.container
  .visits
    - @visits.each do |visit|
      .visit
        = link_to visit_path(visit) do
          .visit_shrine-name
            = visit.shrine.name
          .visit_date
            参拝日：
            = I18n.l(visit.visited_on, format: :long)
          .visit_shrine-prefecture
            所在地：
            = visit.shrine.prefecture
  = link_to new_visit_path do
    .add-button
      %i.fa.fa-plus
