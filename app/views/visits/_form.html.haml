.container
  %ul.error-messages
    - visit.errors.full_messages.each do |message|
      %li= message
  = form_with(model: visit, local: true) do |f|
    .field
      %div
        = f.label :visited_on, '【参拝日】'
      %div
        = f.date_field :visited_on, class: 'text'

    .field
      .label 【神社】
      .select_shrine
        = f.collection_select :shrine_id, current_user.shrines.all, :id, :name_with_prefecture, { include_blank: '既存の神社を選択' }, { class: 'select'}
        = link_to "神社を新規登録", new_shrine_path(return_to: request.fullpath), class: 'button-secondary'

    .field
      %div
        = f.label :image, '【御朱印】'
      %div
        = f.file_field :image

    .field
      .label 【授与品】
      .item-container
        .item-inputs
          = f.fields_for :items do |item_f|
            = item_f.select :category, Item.categories.keys.map { |k| [I18n.t("enum.category.#{k}"), k]}, { include_blank: '選択' }, { class: 'select'}
            .item-row
              = item_f.text_field :name, placeholder: '限定御朱印', class: 'text'
              = "#{item_f.number_field :price, placeholder: '500', class: 'text'}円"
      .item-buttons
        #add-row-button.item-button ＋追加
        #remove-row-button.item-button －削除

      %template#item-template
        .item-inputs
          %select.select{ name: "visit[items_attributes][NEW_RECORD][category]" }
            %option{ value: ""} 選択
            - Item.categories.keys.each do |k|
              %option{ value: k}= I18n.t("enum.category.#{k}")
          .item-row
            %input.text{ type: "text", name: "visit[items_attributes][NEW_RECORD][name]", placeholder: "限定御朱印" }
            %input.text{ type: "number", name: "visit[items_attributes][NEW_RECORD][price]", placeholder: "500" }
            円

    .field
      %div
        = f.label :prayer, '【祈願内容】'
      %div
        = f.text_area :prayer, class: 'text'

    .field
      %div
        = f.label :impression, '【感想】'
      %div
        = f.text_area :impression, class: 'text'

    .field
      = f.submit '保存', class: 'button-primary'
