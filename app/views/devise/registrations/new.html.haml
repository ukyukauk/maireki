.container
  %h2 新規登録
  .form-area
    = form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f|
      = render "devise/shared/error_messages", resource: resource
      .field
        %div
          = f.label :account, 'アカウント名'
        %div
          = f.text_field :account, autofocus: true, autocomplete: "account", class: 'text'

      .field
        %div
          = f.label :email, 'メールアドレス'
        %div
          = f.email_field :email, autocomplete: "email", class: 'text'

      .field
        %div
          = f.label :password
          - if @minimum_password_length
            %p
              %em
                (#{@minimum_password_length} 文字以上)
        %div
          = f.password_field :password, autocomplete: "new-password", class: 'text'

      .field
        %div
          = f.label :password_confirmation
        %div
          = f.password_field :password_confirmation, autocomplete: "new-password", class: 'text'

      .actions
        = f.submit "新規登録", class: 'button-primary'
    = render "devise/shared/links"
